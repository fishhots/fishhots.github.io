---
import { render } from "astro:content";
import { getPublishedAcgnPaths } from "@/core/content/acgn";
import { AcgnArticlePage } from "@/themes/fuyukawa-kagari";

export async function getStaticPaths() {
  return getPublishedAcgnPaths();
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<AcgnArticlePage frontmatter={entry.data} headings={headings}>
  <Content />
</AcgnArticlePage>
